<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="HandheldFriendly" content="True">

  <title>{{meta_title}}</title>

  {{!-- Google Fonts — matches fishfly.ai --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  {{!-- Theme stylesheet --}}
  <link rel="stylesheet" type="text/css" href="{{asset "built/theme.css"}}">

  {{!-- Ghost head: icon, OG tags, JSON-LD, members JS, etc. --}}
  {{ghost_head}}
</head>

<body class="{{body_class}}">
  <div class="page">
    {{> "header"}}

    <main>
      {{{body}}}
    </main>

    {{> "footer"}}
  </div>

  {{!-- FishFly subscribe handler (PR #56).
       Any container with [data-ff-subscribe] gets its <form> submit
       intercepted. Adds `.success` or `.error` class to the form on
       completion — the theme's CSS reveals sibling message elements
       and hides the form on success. Cross-origin fetch to
       https://fishfly.ai/.netlify/functions/subscribe. --}}
  <script>
    (function () {
      var containers = document.querySelectorAll("[data-ff-subscribe]");
      if (!containers.length) return;

      containers.forEach(function (container) {
        var form = container.querySelector("form");
        if (!form) return;

        form.addEventListener("submit", function (e) {
          e.preventDefault();

          var button = form.querySelector("button[type='submit']");
          var emailInput = form.querySelector("input[type='email']");
          var gotchaInput = form.querySelector("input[name='_gotcha']");
          if (!emailInput || !emailInput.value) return;

          var email = emailInput.value.trim();
          var source = container.getAttribute("data-ff-source") || "";
          var gotcha = gotchaInput ? gotchaInput.value : "";

          form.classList.remove("error");
          if (button) {
            button.disabled = true;
            button.dataset.originalText = button.dataset.originalText || button.textContent;
            button.textContent = "Subscribing…";
          }

          fetch("https://fishfly.ai/.netlify/functions/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: email, source: source, _gotcha: gotcha }),
          })
            .then(function (res) {
              return res.json().then(function (data) {
                return { ok: res.ok, data: data };
              });
            })
            .then(function (result) {
              if (result.ok && result.data && result.data.ok) {
                // Success: theme CSS reveals the .subscribe-*-success message
                // and hides the form.
                form.classList.add("success");
              } else {
                throw new Error(result.data && result.data.message || "subscription failed");
              }
            })
            .catch(function (err) {
              console.error("[ff-subscribe]", err);
              form.classList.add("error");
              if (button) {
                button.disabled = false;
                button.textContent = button.dataset.originalText || "Subscribe";
              }
            });
        });
      });
    })();
  </script>

  {{ghost_foot}}
</body>
</html>
