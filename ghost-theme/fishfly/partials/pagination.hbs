{{!-- Older / newer pagination --}}
{{#if pagination.total}}
  {{#if pagination.pages}}
    <nav class="pagination" aria-label="Pagination">
      {{#if pagination.prev}}
        <a href="{{page_url pagination.prev}}" rel="prev">‹ Newer</a>
      {{else}}
        <span></span>
      {{/if}}
      <span class="page-of">Page {{pagination.page}} of {{pagination.pages}}</span>
      {{#if pagination.next}}
        <a href="{{page_url pagination.next}}" rel="next">Older ›</a>
      {{else}}
        <span></span>
      {{/if}}
    </nav>
  {{/if}}
{{/if}}
