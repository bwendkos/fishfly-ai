{{!-- Post card used in index, tag, author listings. --}}
<article class="post-card">
  {{#if feature_image}}
    <a href="{{url}}" aria-hidden="true" tabindex="-1">
      <img class="post-card-image"
           src="{{img_url feature_image size="m"}}"
           srcset="{{img_url feature_image size="s"}} 600w, {{img_url feature_image size="m"}} 1000w, {{img_url feature_image size="l"}} 1600w"
           sizes="(min-width: 900px) 540px, 92vw"
           alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
           loading="lazy" />
    </a>
  {{/if}}
  <div class="post-card-body">
    {{#if primary_tag}}
      <div class="post-card-eyebrow">{{primary_tag.name}}</div>
    {{/if}}
    <h2 class="post-card-title">
      <a href="{{url}}">{{title}}</a>
    </h2>
    {{#if custom_excerpt}}
      <p class="post-card-excerpt">{{custom_excerpt}}</p>
    {{else}}
      <p class="post-card-excerpt">{{excerpt words="22"}}{{#if excerpt}}…{{/if}}</p>
    {{/if}}
    <div class="post-card-meta">
      {{date format="MMM D, YYYY"}}
      {{#if reading_time}}<span class="dot">·</span>{{reading_time}}{{/if}}
    </div>
  </div>
</article>
