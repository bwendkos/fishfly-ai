{{!< default}}
{{!-- Author archive — posts by a single author. --}}

{{#author}}
<section class="index-header">
  <div class="index-eyebrow">Writer</div>
  <h1 class="index-title serif">{{name}}</h1>
  {{#if bio}}
    <p class="index-subtitle serif">{{bio}}</p>
  {{/if}}
  <div class="index-rule"></div>
</section>
{{/author}}

<section class="post-grid">
  {{#foreach posts}}
    {{> "post-card"}}
  {{/foreach}}
</section>

{{> "pagination"}}
